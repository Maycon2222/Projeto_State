{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "jsx": "react-native",
    "module": "preserve",
    "moduleResolution": "bundler",
    "target": "es2022",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "maxNodeModuleJsDepth": 0,
    "strict": false,
    "types": ["node", "react"]
  },
  "include": ["App.js", "index.js", "src/**/*.js", "src/**/*.d.ts"],
  "exclude": ["node_modules", "dist"]
}
